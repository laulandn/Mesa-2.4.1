
AR=m68k-apple-macos-ar
RANLIB=m68k-apple-macos-ranlib
#AR=powerpc-apple-macos-ar
#RANLIB=powerpc-apple-macos-ranlib


all:
	make -f Makefile.r68 -C agl-mini
	make -f Makefile.r68 -C src
	make -f Makefile.r68 -C src-glu
	make -i -f Makefile.r68 -C src-aux
	make -i -f Makefile.r68 -C src-tk
	make -i -f Makefile.r68 -C util
	make -f Makefile.r68 -C GLUT_apple
	make -f Makefile.r68 -C Library\ Sources
#	cp Library\ Sources/*a .
	rm -f *.a
	cp */*.a .
	$(AR) rcv libMesaOpenGLLibrary.a src/*.o Library\ Sources/AGL/Sources/*.o Library\ Sources/AGL/Sources/aglDD/*.o 
	$(RANLIB) libMesaOpenGLLibrary.a
	$(AR) rcv libMesaOpenGLUtility.a src-glu/*.o
	$(RANLIB) libMesaOpenGLUtility.a
	make -f Makefile.r68 -C Examples
	make -i -f Makefile.r68 -C book
	make -i -f Makefile.r68 -C demos
	make -i -f Makefile.r68 -C samples

install:
	make -f Makefile.r68 lib
	# NOTE: Do NOT copy the include files!
	cp *.a $(HOME)/Retro68-build/toolchain/m68k-apple-macos/lib/.
	
clean:
	make -f Makefile.r68 -C agl-mini clean
	make -f Makefile.r68 -C src clean
	make -f Makefile.r68 -C src-glu clean
	make -f Makefile.r68 -C src-aux clean
	make -f Makefile.r68 -C src-tk clean
	make -f Makefile.r68 -C GLUT_apple clean
	make -f Makefile.r68 -C Library\ Sources clean
	make -f Makefile.r68 -C Examples clean
	make -f Makefile.r68 -C book clean
	make -f Makefile.r68 -C demos clean
	make -f Makefile.r68 -C samples clean
	make -f Makefile.r68 -C util clean
	rm -f *.a */*.a
