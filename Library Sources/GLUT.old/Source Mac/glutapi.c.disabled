d!");	\									break;									\							case err_GLUT_OUT_OF_MEM:						\									SignalPStr_("\p Out of memory!");		\									break;									\							default:										\									SignalPStr_("\p Unhandled exception!");	\						}													\					}#define CATCH_GLUT_EXCEPTIONS GLUT_CATCH/* GLUT_CATCH *//* * theApp: The GLUT Application in power-plant: * * Can Initialzed by: *	glutInitWindowPos *	glutInitWindowSize *	glutInitDislpayMode *	glutInit * Otherwise calling a glut function with theApp == NULL will result an error. */ static CGLUTApp	*theApp			= NULL;/****************************************************************************************** * * ValidGLUTApp: Returns if there is a valid glut-application running. * ******************************************************************************************/GLbooleanIsValidGLUTApp(){	return (theApp != NULL);}/* * InitGLUTApp : constructs the glut application */staticvoid InitGLUTApp(){	if (theApp == NULL)	{									// Set Debugging options		SetDebugThrow_(debugAction_Alert);		SetDebugSignal_(debugAction_Alert);		InitializeHeap(3);			// Initialize Memory Manager									// Parameter is number of Master Pointer									//   blocks to allocate										// Initialize standard Toolbox managers		UQDGlobals::InitializeToolbox(&qd);			new LGrowZone(20000);		// Install a GrowZone function to catch									//    low memory situations.		theApp = new CGLUTApp;	}	else	{		SignalPStr_("\pinitGLUTApp: internal error GLUT Application can't initailzes twice");	}}/* * CheckGLUTApp : Check the avability of glut application, throw an exception if  * not avaible. */voidCheckGLUTApp (){	if (!IsValidGLUTApp())	{		Throw_(err_GLUT_NO_APP);	}}/* * DeleteGLUTApp : destructor to the glut application */void DeleteGLUTApp(){	if (theApp == NULL)	{		delete theApp;		theApp = NULL; /* Just to be sure */	}}/* * QuitGLUTApp: Releases the glut application */voidQuitGLUTApp(){	DeleteGLUTApp();}voidglutInit(int *argcp, char **argv){	if (theApp == NULL)	{		// Do the initialization		InitGLUTApp();	}	else	{		// GLUT was initalized once	}}void glutSwapBuffers(void){	GLUT_TRY;		CheckGLUTApp();		theApp->glutSwapBuffers();		GLUT_CATCH;}voidglutInitWindowSize(int width,int height){		GLUT_TRY		if (theApp != NULL)	{		theApp->glutInitWindowSize(width,height);	}	else	{		glutInit(NULL,NULL);		theApp->glutInitWindowSize(width,height);	}	GLUT_CATCH}voidglutInitWindowPosition(int x,int y){	GLUT_TRY	if (theApp != NULL)	{		theApp->glutInitWindowPosition(x,y);	}	else	{		glutInit(NULL,NULL);		theApp->glutInitWindowPosition(x,y);	}		GLUT_CATCH}intglutCreateWindow(char *title){	GLUT_TRY		CheckGLUTApp();	return theApp->glutCreateWindow(title);		GLUT_CATCH  return 0;}voidglutSetWindowTitle(char *title){	GLUT_TRY	CheckGLUTApp();	char str[256];		strcpy(&str[1],title);	str[0] = strlen(&str[1]);		theApp->glutSetWindowTitle(StringPtr(str));		GLUT_CATCH}intglutGetWindow(void){	GLUT_TRY		CheckGLUTApp();		return theApp->glutGetWindow();		GLUT_CATCH  return 0;}voidglutSetWindow(int winID){	GLUT_TRY		CheckGLUTApp();		theApp->glutSetWindow(winID);		GLUT_CATCH}void glutPostRedisplay(void){	GLUT_TRY		CheckGLUTApp();		theApp->glutPostRedisplay();		GLUT_CATCH}voidglutInitDisplayMode(unsigned int mask){	GLUT_TRY		CheckGLUTApp();		theApp->glutInitDisplayMode(mask);	GLUT_CATCH}void glutDisplayFunc(GLUTdisplayCB displayFunc){	GLUT_TRY		CheckGLUTApp();		theApp->glutDisplayFunc(displayFunc);	GLUT_CATCH}void glutVisibilityFunc(GLUTvisibilityCB visiblityFunc){	GLUT_TRY		CheckGLUTApp();		theApp->glutVisibilityFunc(visiblityFunc);		GLUT_CATCH}voidglutReshapeFunc(GLUTreshapeCB reshapeFunc){	GLUT_TRY		CheckGLUTApp();		theApp->glutReshapeFunc(reshapeFunc);		GLUT_CATCH}voidglutKeyboardFunc(GLUTkeyboardCB keyboardFunc){	GLUT_TRY		CheckGLUTApp();		theApp->glutKeyboardFunc(keyboardFunc);		GLUT_CATCH}voidglutSpecialFunc(GLUTspecialCB specialFunc){	GLUT_TRY			CheckGLUTApp();		theApp->glutSpecialFunc(specialFunc);	GLUT_CATCH}voidglutMouseFunc(GLUTmouseCB mouseFunc){	GLUT_TRY		CheckGLUTApp();		theApp->glutMouseFunc(mouseFunc);		GLUT_CATCH}voidglutMotionFunc(GLUTmotionCB motionFunc){	GLUT_TRY		CheckGLUTApp();		theApp->glutMotionFunc(motionFunc);		GLUT_CATCH}voidglutPassiveMotionFunc(GLUTpassiveCB passiveFunc){	GLUT_TRY	CheckGLUTApp();		theApp->glutPassiveMotionFunc(passiveFunc);	GLUT_CATCH	}voidglutEntryFunc(GLUTentryCB entryFunc){	GLUT_TRY	CheckGLUTApp();		theApp->glutEntryFunc(entryFunc);	GLUT_CATCH}voidglutIdleFunc(GLUTidleCB idleFunc){	GLUT_TRY		CheckGLUTApp();		theApp->glutIdleFunc(idleFunc);		GLUT_CATCH}void glutTimerFunc(unsigned int millis, GLUTtimerCB timerFunc, int value){	GLUT_TRY		CheckGLUTApp();		theApp->glutTimerFunc(millis,timerFunc,value);		GLUT_CATCH}intglutCreateMenu(GLUTselectCB selectFunc){	GLUT_TRY		CheckGLUTApp();		return theApp->glutCreateMenu(selectFunc);		GLUT_CATCH  return 0;}void glutSetMenu(int menu){	GLUT_TRY		CheckGLUTApp();		theApp->glutSetMenu(menu);		GLUT_CATCH}void glutDestroyMenu(int menu){	GLUT_TRY		CheckGLUTApp();		theApp->glutDestroyMenu(menu);		GLUT_CATCH}void glutAddMenuEntry(char *label, int value){	GLUT_TRY		CheckGLUTApp();		theApp->glutAddMenuEntry(label,value);	GLUT_CATCH}voidglutAddSubMenu(char *label, int value){	GLUT_TRY		CheckGLUTApp();		theApp->glutAddSubMenu(label,value);	GLUT_CATCH}void glutChangeToMenuEntry(int entry,char *label, int value){	GLUT_TRY		CheckGLUTApp();	theApp->glutChangeToMenuEntry(entry,label,value);	GLUT_CATCH}voidglutMenuStatusFunc(GLUTmenuStatusCB statusFunc){	/* It has no function in macs, because mac menus are pulldown */}voidglutAttachMenu(int button){	GLUT_TRY		CheckGLUTApp();		theApp->glutAttachMenu(button);		GLUT_CATCH}voidglutMainLoop(void){	GLUT_TRY			theApp->Run();				DeleteGLUTApp();			GLUT_CATCH}