enu();		}	}}voidCGLUTMenu::ChangeToMenuEntry(int entry, char* inName, int value){	char NameStr[255];		BlockMove (inName,&NameStr[1],strlen(inName));	NameStr[0] = strlen(inName);		SetMenuItemText(GetMacMenuH(),entry,(ConstStr255Param) NameStr);	SetCommand(entry,value);	// Not sub-menu:	SetItemCmd(GetMacMenuH(),entry,0);	SetItemMark(GetMacMenuH(),entry,0);}voidCGLUTMenu::ChangeToSubMenu(int inEntry, char *inName, const CGLUTMenu *inSubMenu){	char NameStr[255];		if (inEntry > ::CountMItems(GetMacMenuH()))	{		SignalPStr_("\pChangeToSubMenu: inEntry > a menu elemeinek a sz‡ma!");		return;	}	BlockMove (inName,&NameStr[1],strlen(inName));	NameStr[0] = strlen(inName);		SetMenuItemText(GetMacMenuH(),inEntry,(ConstStr255Param) NameStr);	SetCommand(inEntry,inSubMenu->GetGlutID());		SetItemCmd(GetMacMenuH(),inEntry,hMenuCmd);	SetItemCmd(GetMacMenuH(),inEntry,inSubMenu->GetMenuID());}voidCGLUTMenu::SelectItem(int inItem, int inMenu){	if (inMenu == GetMenuID())	{		if (select != NULL)		{			select(CommandFromIndex(inItem));		}	}	else	{		CGLUTMenu *submenu = mGlutApp->FindGlutMenu(macIDToGlutID(inMenu));				submenu->SelectItem(inItem,inMenu);	}}void CGLUTMenu::SelectMenu(const SMouseDownEvent&	inMouseDown){	InsertMenu();			long result = PopUpMenuSelect(GetMacMenuH(),							   inMouseDown.macEvent.where.v,							   inMouseDown.macEvent.where.h,0);	if (result != 0)	{		SelectItem(LoWord(result),HiWord(result));	}}