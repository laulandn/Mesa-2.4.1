/* * 1997/06/18: Inserted error checking after aglMakeCurrent. */#include "CGLUTApp.h"#include "CGLUTMenu.h"#include "CGLUTWindow.h"#include "timer.h"#include "stdio.h"#include "string.h"#include <LString.h>#include <LCaption.h>#include <UReanimator.h>// // Constants for the info-window panes.//staticconst ResIDT	kInfoWindowID			= 2;staticconst PaneIDT	kInfoOpenGLVersionCapt 	= 'oglv';staticconst PaneIDT	kInfoAGLVersionCapt 	= 'aglv';staticconst PaneIDT	kInfoFramesPerSecCapt 	= 'fps ';staticconst PaneIDT	kInfoFreeMemCapt 		= 'free';staticconst PaneIDT	kInfoNameCapt 			= 'name';staticconst PaneIDT	kInfoExtensionsCapt 	= 'exte';staticconst PaneIDT	kInfoVendorCapt 		= 'vend';staticconst PaneIDT	kInfoRendererCapt 		= 'rend';staticconst PaneIDT 	kInfoWidthCapt			= 'widt';staticconst PaneIDT	kInfoHeightCapt			= 'heig';//// Utility functions for measuring time://static double now(void){   UnsignedWide time;      Microseconds(&time);      return (time.hi*(65536.0*65536.0/1000000.0)+time.lo/1000000.0);}// ÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑ//		¥ ObeyCommand										 	  [public]// ÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑ//	Respond to commandsBooleanCGLUTWindow::ObeyCommand(	CommandT	inCommand,	void		*ioParam){	Boolean cmdHandled = true;		switch(inCommand)	{		case cmd_ShowInfoWindow:			if (!IsInfoWindowOpen())				OpenInfoWindow();		default:			cmdHandled = LWindow::ObeyCommand(inCommand, ioParam);			break;	}	return cmdHandled;}// ÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑ//		¥ FindCommandStatus										 	  [public]// ÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑÑ//	This function enables menu commands.//voidCGLUTWindow::FindCommandStatus(	CommandT	inCommand,	Boolean		&outEnabled,	Boolean		&outUsesMark,	Char16		&outMark,	Str255		outName){	switch (inCommand) {		case cmd_ShowInfoWindow:			outEnabled = !IsInfoWindowOpen();		// Return menu item status according to command messages.		// Any that you don't handle will be passed to LApplication			break;		default:			LWindow::FindCommandStatus(inCommand, outEnabled,												outUsesMark, outMark, outName);			break;	}}// ---------------------------------------------------------------------------//		¥ ResizeFrameBy// ---------------------------------------------------------------------------//	Resize the window voidCGLUTWindow::ResizeFrameBy(							Int16				inWidthDelta,							Int16				inHeightDelta,							Boolean				inRefresh){	LWindow::ResizeFrameBy(inWidthDelta,inHeightDelta,inRefresh);		if (IsVisible())	{		// Reshape the GLUT context		Reshape();			// Force refresh to PP		Refresh();	}}// ---------------------------------------------------------------------------//		¥ ClickInDrag// ---------------------------------------------------------------------------//	Handle click in drag region of a WindowvoidCGLUTWindow::ClickInDrag(	const EventRecord	&inMacEvent){	LWindow::ClickInDrag(inMacEvent);		/*	 * Update the AGL context.	 */	SetAGLPort();	aglUpdateCurrent();}// ---------------------------------------------------------------------------//		¥ ClickSelf// ---------------------------------------------------------------------------//	Respond to Click inside the windowvoidCGLUTWindow::ClickSelf(	const SMouseDownEvent&	inMouseDown){	int button = 0;		if ((inMouseDown.macEvent.modifiers & controlKey) != 0)	{		button = GLUT_LEFT_BUTTON;	}			if ((inMouseDown.macEvent.modifiers & optionKey) != 0)	{		button |= GLUT_MIDDLE_BUTTON;	}			if ((inMouseDown.macEvent.modifiers & cmdKey) != 0)	{		button |= GLUT_RIGHT_BUTTON;	}		if (button == 0)	{		button = GLUT_LEFT_BUTTON;	}		// Do menu	if (mMenu != NULL)	{		if ((mMenuButton & button) != 0)		{			mMenu->SelectMenu(inMouseDown);		}	}		// Call mouse callback	if (mMouseCB != NULL)	{		mMouseCB(button,GLUT_DOWN,inMouseDown.whereLocal.h,inMouseDown.whereLocal.v);	}}// ---------------------------------------------------------------------------//		¥ EventMouseUp// ---------------------------------------------------------------------------//	Respond to a mouse up event following a click (mouse down) inside a PanevoidCGLUTWindow::EventMouseUp(	const EventRecord&		inMouseUp){	//Call mouse callback	if (mMouseCB != NULL)	{		int button = 0;			if ((inMouseUp.modifiers & controlKey) != 0)		{			button = GLUT_LEFT_BUTTON;		}				if ((inMouseUp.modifiers & optionKey) != 0)		{			button |= GLUT_MIDDLE_BUTTON;		}				if ((inMouseUp.modifiers & cmdKey) != 0)		{			button |= GLUT_RIGHT_BUTTON;		}			if (button == 0)		{			button = GLUT_LEFT_BUTTON;		}				mMouseCB(button,GLUT_UP,inMouseUp.where.h,inMouseUp.where.v);	}}// ---------------------------------------------------------------------------//		¥ AdjustCursorSelf// ---------------------------------------------------------------------------//	Function for implementing mouse tracking. voidCGLUTWindow::AdjustCursorSelf(Point inPortPt,							  const EventRecord &inMacEvent){	if ((inMacEvent.modifiers & btnState) == 0)	{		if (mMotionCB != NULL)		{			mMotionCB(inPortPt.h,inPortPt.v);		}	}	else	{		if (mPassiveCB != NULL)		{			mPassiveCB(inPortPt.h,inPortPt.v);		}	}}// ---------------------------------------------------------------------------//		¥ MouseEnter// ---------------------------------------------------------------------------//	Function for implementing entry callback. voidCGLUTWindow::MouseEnter(					Point 				inPortPt,					const EventRecord 	&inMacEvent){	#pragma unused(inPortPt)	#pragma unused(inMacEvent)		if (mEntryCB != NULL)	{		mEntryCB(GLUT_ENTERED);	}}// ---------------------------------------------------------------------------//		¥ MouseLeave// ---------------------------------------------------------------------------//	Function for implementing entry callback. voidCGLUTWindow::MouseLeave(){	if (mEntryCB != NULL)	{		mEntryCB(GLUT_LEFT);	}}// ---------------------------------------------------------------------------//		¥ DrawSelf// ---------------------------------------------------------------------------//	Draw the windowvoidCGLUTWindow::DrawSelf(){	Redisplay();		// Draw resize box	// DrawSizeBox();}// ---------------------------------------------------------------------------//		¥ HandleKeyPress// ---------------------------------------------------------------------------// Handles key down in a glut windowBoolean			CGLUTWindow::HandleKeyPress(								const EventRecord	&inKeyEvent){	Boolean		keyHandled = false;	int			specKey = 0;	char		key = 0;			key = (char)(inKeyEvent.message & charCodeMask);			switch (key)	{		case 0x1C:	specKey = GLUT_KEY_LEFT; break;		case 0x1D:	specKey = GLUT_KEY_RIGHT; break;		case 0x1E:	specKey = GLUT_KEY_UP; break;		case 0x1F:  specKey = GLUT_KEY_DOWN; break;	}		if (specKey != 0)	{		if (mSpecialCB != NULL)		{			mSpecialCB(specKey,0,0);			return true;		}	}			if (('a' <= key <= 'z') || ('A' <= key <= 'Z') || ('0' <= key <= '9'))	{		if (mKeyboardCB != NULL)		{			mKeyboardCB(key,0,0);			return true;		}	}	keyHandled = LWindow::HandleKeyPress(inKeyEvent);		return keyHandled;}void CGLUTWindow::SwapBuffers(){  aglSwapBuffers(NULL); /* Note we are old opengl so we ignore the parameter */}void CGLUTWindow::Reshape(){	if (ctx == NULL)	  return;		SetAGLPort();	aglUpdateCurrent();		if (mReshapeCB != NULL)	{		SDimension16 size;				GetFrameSize(size);		mReshapeCB(size.width,size.height);	}	else	{		// Default reshape:		SDimension16 size;				GetFrameSize(size);		glViewport(0,0,size.width,size.height);	}}void CGLUTWindow::Redisplay(){	SetAGLPort();	/*	 * Call reshape for the first time.	 */	if (mForceReshape)	{		Reshape();		mForceReshape = false;	}		/*	 * Do the display.	 */	if (mDisplayCB != NULL)	{		/* Update the agl-Context */		aglUpdateCurrent();		double time0 = now();		mDisplayCB();		double time1 = now();		time1 -= time0;		if (time1 > 0.0)		{			time1 = 1.0/time1;		}		if (mInfoWindow != NULL)		{			LStr255	  framePerSec((double)time1,4,2);			LStr255	  freeMem((long)FreeMem()/1024);			Rect	  portRect;						Assert_(CalcPortFrameRect(portRect));						LStr255	  height((long)portRect.bottom-portRect.top);			LStr255	  width((long)portRect.right-portRect.left);									freeMem += "\p Kb";			framePerSec += "\p Frames/Sec";			LCaption  *framesPSLabel = (LCaption*)mInfoWindow->FindPaneByID(kInfoFramesPerSecCapt);			LCaption  *freeMemLabel = (LCaption*)mInfoWindow->FindPaneByID(kInfoFreeMemCapt);			LCaption  *widthLabel = (LCaption*)mInfoWindow->FindPaneByID(kInfoWidthCapt);			LCaption  *heightLabel = (LCaption*)mInfoWindow->FindPaneByID(kInfoHeightCapt);			framesPSLabel->SetDescriptor(framePerSec);			freeMemLabel->SetDescriptor(freeMem);			widthLabel->SetDescriptor(height);			heightLabel->SetDescriptor(width);		}		  aglSwapBuffers(NULL); /* Note we are old opengl so we ignore the parameter */	}	else	{		// TODO Error	}	}voidCGLUTWindow::SetAGLPort(){	GLboolean error;		if (aglGetCurrentContext() != ctx)	{		error = aglMakeCurrent((AGLDrawable)GetMacPort(),ctx);				if (error != GL_TRUE)		{						throw err_GLUT_FATAL_ERROR;		}	}	else	{		// TODO	}}// ---------------------------------------------------------------------------//		¥ CGLUTWindow(LStream*)// ---------------------------------------------------------------------------//	Construct Window from the data in a streamCGLUTWindow::CGLUTWindow(				LStream	*inStream)		:LWindow(inStream){	ctx = NULL;	pixFmt = NULL;		// Callbacks:	mDisplayCB = NULL;	mReshapeCB = NULL;	mKeyboardCB = NULL;	mMouseCB = NULL;	mSpecialCB = NULL;	mMotionCB = NULL;	mPassiveCB = NULL;	mEntryCB = NULL;		// Menu	mMenu = NULL;	mMenuButton = 0;		mGlutID = kGlutID_Invalid;		// Info window	mInfoWindow = NULL;				// Default glut-window cursor	mGlutCursor = GLUT_CURSOR_RIGHT_ARROW; 		mForceReshape = true;	SetRefreshAllWhenResized(true);}// ---------------------------------------------------------------------------//		¥ CGLUTWindow [static]// ---------------------------------------------------------------------------//	Create a new DialogBox object initialized using data from a StreamCGLUTWindow*CGLUTWindow::CreateGLUTWindowStream(	LStream	*inStream){	return (new CGLUTWindow(inStream));}// ---------------------------------------------------------------------------//		¥ GetGLContext// ---------------------------------------------------------------------------//	Returns the OpenGL context attached to this windowAGLContextCGLUTWindow::GetGLContext(){	return ctx;}// ---------------------------------------------------------------------------//		¥ SetGLContext// ---------------------------------------------------------------------------//	Attach an OpenGL context to this windowvoidCGLUTWindow::CreateGLContext(AGLPixelFmt inPixFmt){	GLboolean error;		if (ctx != NULL)	{		aglDestroyContext(ctx);			}		pixFmt = inPixFmt;	if (pixFmt == NULL)	{		throw err_GLUT_FATAL_ERROR;	}		ctx = aglCreateContext(pixFmt,NULL);	if (ctx == NULL)	{		SignalPStr_("\pCan't initialze the main window!");		throw err_GLUT_FATAL_ERROR;	}		error = aglMakeCurrent((AGLDrawable)GetMacPort(),ctx);		if (error != GL_TRUE)	{		SignalPStr_("\pAglMakeCurrent failed!");		throw err_GLUT_FATAL_ERROR;			}}// ---------------------------------------------------------------------------//		¥ SetDisplayFunc// ---------------------------------------------------------------------------//	Attach a Display Func to the windowvoidCGLUTWindow::SetDisplayFunc(const GLUTdisplayCB	inDisplayFunc){	mDisplayCB = inDisplayFunc;}// ---------------------------------------------------------------------------//		¥ SetVisiblityFunc// ---------------------------------------------------------------------------//	Attach a visibilty Func to the windowvoidCGLUTWindow::SetVisibilityFunc(const GLUTvisibilityCB	inVisibilityFunc){	mVisiblityCB = inVisibilityFunc;}// ---------------------------------------------------------------------------//		¥ SetReshapeFunc// ---------------------------------------------------------------------------//	Attach a Reshape Func to the windowvoidCGLUTWindow::SetReshapeFunc(const GLUTreshapeCB	inReshapeFunc){	mReshapeCB = inReshapeFunc;}// ---------------------------------------------------------------------------//		¥ SetKeyboardFunc// ---------------------------------------------------------------------------//	Attach a Keyboard Func to the windowvoidCGLUTWindow::SetKeyboardFunc(const GLUTkeyboardCB inKeyboardFunc){	mKeyboardCB = inKeyboardFunc;}// ---------------------------------------------------------------------------//		¥ SetSpecialFunc// ---------------------------------------------------------------------------//	Attach a Special keyboard Func to the windowvoidCGLUTWindow::SetSpecialFunc(const GLUTspecialCB inSpecialFunc){	mSpecialCB = inSpecialFunc;}// ---------------------------------------------------------------------------//		¥ SetMouseFunc// ---------------------------------------------------------------------------//	Attach a Mouse to the windowvoidCGLUTWindow::SetMouseFunc(const GLUTmouseCB inMouseFunc){	mMouseCB = inMouseFunc;}// ---------------------------------------------------------------------------//		¥ SetMotionFunc// ---------------------------------------------------------------------------//	Attach a motion callback to the windowvoidCGLUTWindow::SetMotionFunc(const GLUTmotionCB inMotionFunc){	mMotionCB = inMotionFunc;}// ---------------------------------------------------------------------------//		¥ SetMotionFunc// ---------------------------------------------------------------------------//	Attach a motion callback to the windowvoidCGLUTWindow::SetEntryFunc(const GLUTentryCB inEntryFunc){	mEntryCB = inEntryFunc;}// ---------------------------------------------------------------------------//		¥ SetPassiveFunc// ---------------------------------------------------------------------------//	Attach a passive motion callback to the windowvoidCGLUTWindow::SetPassiveFunc(const GLUTpassiveCB inPassiveFunc){	mPassiveCB = inPassiveFunc;}// ---------------------------------------------------------------------------//		¥ Attach a menu to the window// ---------------------------------------------------------------------------//	Attach a menu to the windowvoidCGLUTWindow::AttachMenu(CGLUTMenu *inMenu,int inButton){	if (mMenu == inMenu)	{		mMenuButton |= inButton;	}	else	{		mMenu = inMenu;		mMenuButton = inButton;	}}// ---------------------------------------------------------------------------//		¥ CreateWindow// ---------------------------------------------------------------------------//	Return a newly created Window object initialized from a PPob resourceCGLUTWindow*CGLUTWindow::CreateGLUTWindow(	ResIDT		inWindowID,	LCommander	*inSuperCommander){    // Create a new window	SetDefaultCommander(inSuperCommander);	SetDefaultAttachable(nil);		CGLUTWindow	*theWindow =			(CGLUTWindow*) UReanimator::ReadObjects('PPob', inWindowID);	theWindow->FinishCreate();	if (theWindow->HasAttribute(windAttr_ShowNew)) {		theWindow->Show();	}		return theWindow;}// ---------------------------------------------------------------------------//		¥ SetCursor// ---------------------------------------------------------------------------//	glutSetCursor changes the cursor image of the current window.voidCGLUTWindow::glutSetCursor(int inCursor){	mGlutCursor = inCursor;}// ---------------------------------------------------------------------------//		¥ glutGet// ---------------------------------------------------------------------------//	glutGet changes the cursor image of the current window.intCGLUTWindow::glutGet(GLenum status){	switch (status)	{		case GLUT_WINDOW_X:			{				Rect bounds;								GetGlobalBounds(bounds);				return bounds.left;			}		case GLUT_WINDOW_Y:			{				Rect bounds;								GetGlobalBounds(bounds);				return bounds.top;			}		case GLUT_WINDOW_WIDTH:			{				Rect bounds;								GetGlobalBounds(bounds);				return bounds.right-bounds.left;			}		case GLUT_WINDOW_HEIGHT:			{				Rect bounds;								GetGlobalBounds(bounds);				return bounds.bottom-bounds.top;			}		case GLUT_WINDOW_BUFFER_SIZE:			{				GLint result;								Assert_(aglGetConfig(pixFmt,AGL_BUFFER_SIZE,&result));				return result;			}		case GLUT_WINDOW_STENCIL_SIZE:			{				GLint result;								Assert_(aglGetConfig(pixFmt,AGL_STENCIL_SIZE,&result));				return result;			}		case GLUT_WINDOW_DEPTH_SIZE:			{				GLint result;								Assert_(aglGetConfig(pixFmt,AGL_DEPTH_SIZE,&result));				return result;			}		case GLUT_WINDOW_RED_SIZE:			{				GLint result;								Assert_(aglGetConfig(pixFmt,AGL_RED_SIZE,&result));				return result;			}		case GLUT_WINDOW_GREEN_SIZE:			{				GLint result;								Assert_(aglGetConfig(pixFmt,AGL_GREEN_SIZE,&result));				return result;			}		case GLUT_WINDOW_BLUE_SIZE:			{				GLint result;								Assert_(aglGetConfig(pixFmt,AGL_BLUE_SIZE,&result));				return result;			}		case GLUT_WINDOW_ALPHA_SIZE:			{				GLint result;								Assert_(aglGetConfig(pixFmt,AGL_ALPHA_SIZE,&result));				return result;			}		case GLUT_WINDOW_ACCUM_RED_SIZE:			{				GLint result;								Assert_(aglGetConfig(pixFmt,AGL_ACCUM_GREEN_SIZE,&result));				return result;			}		case GLUT_WINDOW_ACCUM_GREEN_SIZE:			{				GLint result;								Assert_(aglGetConfig(pixFmt,AGL_ACCUM_GREEN_SIZE,&result));				return result;			}		case GLUT_WINDOW_ACCUM_BLUE_SIZE:			{				GLint result;								Assert_(aglGetConfig(pixFmt,AGL_ACCUM_BLUE_SIZE,&result));				return result;			}		case GLUT_WINDOW_ACCUM_ALPHA_SIZE:			{				GLint result;								Assert_(aglGetConfig(pixFmt,AGL_ACCUM_ALPHA_SIZE,&result));				return result;			}		case GLUT_WINDOW_DOUBLEBUFFER:			{				GLint result;								Assert_(aglGetConfig(pixFmt,AGL_DOUBLEBUFFER,&result));				return result;			}		case GLUT_WINDOW_RGBA:			{				GLint result;								Assert_(aglGetConfig(pixFmt,AGL_RGBA,&result));				return result;			}		case GLUT_WINDOW_PARENT:			{				/* TODO */				return 0;			}		case GLUT_WINDOW_NUM_CHILDREN:			{				/* TODO */				return 0;			}		case GLUT_WINDOW_COLORMAP_SIZE:			{				/* TODO */				return 0;			}		case GLUT_WINDOW_NUM_SAMPLES:			{				/* TODO */				return 0;			}		case GLUT_WINDOW_STEREO:			{				GLint result;								Assert_(aglGetConfig(pixFmt,AGL_STEREO,&result));				return result;			}		case GLUT_WINDOW_CURSOR:			{				return mGlutCursor;			}		case GLUT_NORMAL_DAMAGED:			{				/* TODO */				return GL_FALSE;			}	}		return GL_FALSE;}// ---------------------------------------------------------------------------//		¥ HideWindow// ---------------------------------------------------------------------------//	glutHideWindow will hide the current windowvoidCGLUTWindow::HideWindow(void){	if (mVisibilityStatus != GLUT_NOT_VISIBLE)	{		Hide();		mVisibilityStatus = GLUT_NOT_VISIBLE;				if (mVisiblityCB != NULL)			mVisiblityCB(mVisibilityStatus);	}}// ---------------------------------------------------------------------------//		¥ CreateWindow// ---------------------------------------------------------------------------//	glutHideWindow will show the current windowvoidCGLUTWindow::ShowWindow(void){	if (mVisibilityStatus != GLUT_VISIBLE)	{		Show();		mVisibilityStatus = GLUT_VISIBLE;				if (mVisiblityCB != NULL)			mVisiblityCB(mVisibilityStatus);	}}// ---------------------------------------------------------------------------//		¥ ~CGLUTWindow 			// Destroys the OpenGL window// ---------------------------------------------------------------------------//	DestructorCGLUTWindow::~CGLUTWindow(){	if (ctx != NULL) 	{		aglDestroyContext(ctx);	}		if (pixFmt != NULL)	{		DisposePtr((Ptr)pixFmt);	}		if (mInfoWindow != NULL)	{		delete mInfoWindow;		mInfoWindow = NULL;	}}#pragma mark --------INFO-Window-----------// ---------------------------------------------------------------------------//		¥ AllowSubRemoval// ---------------------------------------------------------------------------// Allow the close of the info windowBoolean			CGLUTWindow::AllowSubRemoval(								LCommander *inCommander){	if (inCommander == mInfoWindow)	{		mInfoWindow = NULL;		return true;	}	// Send an update-menus.	ObeyCommand(cmd_UpdateMenus,NULL);		return true;}// ---------------------------------------------------------------------------//		¥ IsInfoWindowOpen 			// ---------------------------------------------------------------------------//	Returns true if the info window is openBooleanCGLUTWindow::IsInfoWindowOpen(){	return (mInfoWindow != NULL);}// ---------------------------------------------------------------------------//		¥ OpenInfoWindow 			// ---------------------------------------------------------------------------//	Opens the info windowvoidCGLUTWindow::OpenInfoWindow(){		LWindow *theWindow = LWindow::CreateWindow(kInfoWindowID,this);		LStr255 versStr,str;		Str255	temp;		char 	tempStr[255];						int majorVers,minorVers;						aglQueryVersion(&majorVers,&minorVers);						versStr = (long)majorVers;		str = (long)minorVers;		versStr += "\p.";		versStr += str;						LCaption  *aglVersionLabel = (LCaption*)theWindow->FindPaneByID(kInfoAGLVersionCapt);		LCaption  *framesPSLabel = (LCaption*)theWindow->FindPaneByID(kInfoFramesPerSecCapt);		LCaption  *freeMemLabel = (LCaption*)theWindow->FindPaneByID(kInfoFreeMemCapt);		LCaption  *nameCapt	= (LCaption*)theWindow->FindPaneByID(kInfoNameCapt);						str = (long)(::FreeMem()/1024);		str += "\p Kb";						aglVersionLabel->SetDescriptor(StringPtr(versStr));		freeMemLabel->SetDescriptor(StringPtr(str));		framesPSLabel->SetDescriptor("\pUnknown");		nameCapt->SetDescriptor(GetDescriptor(temp));				// Extensions		LCaption *extensionsLabel = (LCaption*)theWindow->FindPaneByID(kInfoExtensionsCapt);		strcpy(&tempStr[1], (char*)glGetString(GL_EXTENSIONS));		tempStr[0] = strlen(&tempStr[1]);		extensionsLabel->SetDescriptor(StringPtr(tempStr));				// Version		LCaption  *oglVersionLabel = (LCaption*)theWindow->FindPaneByID(kInfoOpenGLVersionCapt);		strcpy(&tempStr[1], (char*)glGetString(GL_VERSION));		tempStr[0] = strlen(&tempStr[1]);		oglVersionLabel->SetDescriptor(StringPtr(tempStr));				// Vendor		LCaption  *oglVendorLabel = (LCaption*)theWindow->FindPaneByID(kInfoVendorCapt);		strcpy(&tempStr[1], (char*)glGetString(GL_VENDOR));		tempStr[0] = strlen(&tempStr[1]);		oglVendorLabel->SetDescriptor(StringPtr(tempStr));				// Renderer		LCaption  *oglRendererLabel = (LCaption*)theWindow->FindPaneByID(kInfoRendererCapt);		strcpy(&tempStr[1], (char*)glGetString(GL_RENDERER));		tempStr[0] = strlen(&tempStr[1]);		oglRendererLabel->SetDescriptor(StringPtr(tempStr));				mInfoWindow = theWindow;}