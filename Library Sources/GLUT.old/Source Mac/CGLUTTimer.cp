#include "CGLUTTimer.h"#include "timer.h"// ---------------------------------------------------------------------------//		¥ milliseconds// ---------------------------------------------------------------------------//	Return the current time since the boot-upstatic UInt32 milliseconds(){   UInt32 ticks;      ticks = TickCount();      return (ticks*16.66);}// ---------------------------------------------------------------------------//		¥ CGLUTTimer// ---------------------------------------------------------------------------//	ConstructorCGLUTTimer::CGLUTTimer(			unsigned int inMsecs,			GLUTtimerCB inTimer,			int inValue){	// Init the variables	value = inValue;	timer = inTimer;	msecs = inMsecs;	lastTime = 0;}// ---------------------------------------------------------------------------//		¥ CGLUTTimer// ---------------------------------------------------------------------------//	DestructorCGLUTTimer::~CGLUTTimer(){}// ---------------------------------------------------------------------------//		¥ SpendTime// ---------------------------------------------------------------------------//	Call the timervoidCGLUTTimer::SpendTime(	const EventRecord	&inMacEvent){	UInt32 currentTime;		currentTime = milliseconds();		if ((currentTime - lastTime) >= msecs)	{		if ((currentTime - lastTime) < 2*msecs) {					}		lastTime = lastTime+msecs;		if (timer != NULL)		{			timer(value);		}	}}