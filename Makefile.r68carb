
#AR=m68k-apple-macos-ar
#RANLIB=m68k-apple-macos-ranlib
AR=powerpc-apple-macos-ar
RANLIB=powerpc-apple-macos-ranlib


all:
	make -f Makefile.r68carb -C src
	make -f Makefile.r68carb -C src-glu
	make -f Makefile.r68carb -C Library\ Sources
	make -f Makefile.r68carb -C Examples
	make -f Makefile.r68carb -C Library\ Sources lib
	cp Library\ Sources/*a .
	
clean:
	make -f Makefile.r68carb -C src clean
	make -f Makefile.r68carb -C src-glu clean
	make -f Makefile.r68carb -C Library\ Sources clean
	make -f Makefile.r68carb -C Examples clean
	rm -f *.a */*.a
